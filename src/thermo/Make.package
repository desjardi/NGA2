f90EXE_sources += ideal_gas_class.f90 stiffened_gas_class.f90 nasg_class.f90 igmix_class.f90 mie_gruneisen_class.f90
f90EXE_sources += relax_ig_sg_class.f90 relax_ig_nasg_class.f90 relax_igmix_sg_class.f90 relax_igmix_nasg_class.f90
f90EXE_sources += relax_numerical_class.f90

# CoolProp-backed material: only built when linking CoolProp (see tools/GNUMake/packages/Make.coolprop)
ifeq ($(USE_COOLPROP),TRUE)
  f90EXE_sources += coolprop_cdef.f90 coolprop_class.f90
endif

INCLUDE_LOCATIONS += $(NGA_HOME)/src/thermo
VPATH_LOCATIONS   += $(NGA_HOME)/src/thermo
