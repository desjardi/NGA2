# AMR multiphase solvers
f90EXE_sources += amrvof_class.f90 amrvof_geometry.f90 amrmpflow_class.f90 amrmpcomp_class.f90 amrmpinc_class.f90

# PLICnet for interface normal reconstruction (from two_phase)
f90EXE_sources += plicnet.f90

INCLUDE_LOCATIONS += $(NGA_HOME)/src/amrmpsolvers
VPATH_LOCATIONS   += $(NGA_HOME)/src/amrmpsolvers
INCLUDE_LOCATIONS += $(NGA_HOME)/src/two_phase
VPATH_LOCATIONS   += $(NGA_HOME)/src/two_phase

# Thermo (material EOS + relax used by amrmpcomp)
f90EXE_sources += material_class.f90 ideal_gas_class.f90 stiffened_gas_class.f90 thermorelax_class.f90 relax_ig_sg_class.f90
INCLUDE_LOCATIONS += $(NGA_HOME)/src/thermo
VPATH_LOCATIONS   += $(NGA_HOME)/src/thermo
