# ============================================================================
#  amrpd_impact -- shock-driven LIQUID drop -> PD wall impact, COUPLED to the gas.
#  Same flow conditions as amrcomp_impact (Parziale nondim, live shock at 9.4,
#  drop at 10 riding the pre-shock stream into the wall), but the rigid wall is
#  replaced by a clamped copper PD slab in [-Wall thickness,0]; the multiphase
#  fluid (amrmpcomp) is two-way IB-coupled to it (Usolid forcing + div(sigma)
#  load). True reflecting wall BC sits at x=xlo=-Wall thickness. The PD disk
#  projectile variant is retired (commented out in simulation.f90).
# ============================================================================

# AMR grid
Base nx:   32
Base ny:   32
Base nz:   1
Max level: 6

# Regridding parameters
Regrid nsteps:      10
Tag Reynolds value: 100
Tag density error:  0.6
Tag pressure error: 0.3
Tag Ducros value:   0.5

# Geometry: true (reflecting) wall BC shifted to x=-Wall thickness; PD wall in [-Wall thickness,0]
Domain length:  20      # length unchanged; domain SHIFTED to [-Wall thickness, 20-Wall thickness] = [-1,19]
Drop location:  10      # same as amrcomp_impact: drop co-moving with the pre-shock stream
Shock location: 9.4     # live shock inside the domain, same as amrcomp_impact
Wall BC:        slip

# ---- PD solid bodies (clamped wall slab + incoming disk projectile) ----
# Copper wall, viscoplastic, nondim by (rhoG2, Delta-u, p_ref=rhoG2*Delta-u^2=14.8 MPa)
Material density:    1197.0    # rho_Cu/rho_ref = 8960/7.49
Elastic modulus:     7900.0    # E_Cu/p_ref = 117 GPa / 14.8 MPa
Poisson ratio:       0.34
Yield stress:        1.889     # ANNEALED: JC A/p_ref = 28 MPa / 14.82 MPa (baseline was 10.27 = flat 152 MPa, no hardening)
Hardening modulus:   26.98     # JC B/p_ref = 400 MPa / 14.82 MPa (their n=1 -> linear); flow stress = A + B*eps_p
#Yield stretch:      0.0013    # legacy per-bond criterion (mode-dependent flow stress; superseded by Yield stress)
Relaxation time:     0.01      # viscoplastic flow rate (small -> near rate-independent)
Relaxation fraction: 1.0       # full deviatoric plastic flow above yield
Failure stretch:     0.3       # ductile: ~30% elongation before tearing
#Critical energy:    1.0e-3    # unused (ductile failure via Failure stretch)
Element size:       0.00625    # fine dx (L6)=0.00977 -> ~1.56x elem -> ~2.4 particles/fine cell (smooth VF)
Tagging VF:         0.1
# Wall: x in [0,Wall thickness], y in [-Wall half-height, +half]; back layer clamped
Wall thickness:     2.0
Wall half-height:   4.0
# Disk: center (Disk location,0), radius Disk radius, moving -x at Impact velocity
Disk radius:        0.5        # diameter 1 = drop diameter (the length scale)
Disk location:      3.0        # near the wall: front at 2.5 (just past shock at 2), wall front at 0
Impact velocity:    1.0        # U=1, co-moving with the pre-shock gas (u1=-1) -> no t=0 IB slip

# ---- Two-way IB coupling switches ----
Couple solid to fluid: .true.  # IB forcing of the gas by the moving solid
Couple fluid to solid: .true.  # div(sigma) load on the PD particles
PD start time: 9               # solid frozen (rigid static wall, no PD stepping) until t reaches this;
                               # 0 = active from the start; huge = permanent rigid wall

# EOS parameters
GammaG: 1.3
# Liquid water: Mie-Gruneisen, nondim, generated by scripts/fit_mg.py (2026-07-16)
#   data: Marsh LASL water Hugoniot pp.573-575 (3-44 GPa) + IAPWS-95 sub-GPa branch
#   SI: rho0=998.21, c0=1482.35 (pinned to IAPWS), Gamma0=0.4252 (fit), cv=3810 (isochore fit), T0=293.15 K
Liquid rho0:      133.23213
Liquid c0:        1.0538384
Liquid s1:        1.913527
Liquid s2:        0.87367508
Liquid s3:        -2.9499476
Liquid Gamma0:    0.42520111
Liquid cv:        2.6853288
Liquid T0:        0.21023893
# Energy gauge q=cv*T0: amrmpcomp rails assume phasic e>0 (pure origin shift, no physics change)
Liquid q:         0.56456065
Liquid qp:        19.442305
# Tension floor (cavitation surrogate; MG has no built-in limit) = old NASG -0.98*pinf value
Liquid Pmin:      -53.94
Gas Mach number:   1.95
Weber number:      3.69e5
Reynolds number:   3e5
Prandtl number:    0.71
Viscosity ratio:   21.05
Diffusivity ratio: 8.34
Sutherland exponent:    1.5
Sutherland temperature: 0.073

# Time integration
Max dt:   1e-3
Max CFL:  0.75
Max time: 30            # drop front reaches the PD wall face (x=0) at t~10, then aftermath

# Output
Output period:     1e-1
Checkpoint period: 1
Restart from:      !restart/impact_3.00165E+00
