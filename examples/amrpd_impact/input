# ============================================================================
#  amrpd_impact -- PHASE 2: copper PD disk -> PD wall impact, COUPLED to the gas.
#  The multiphase fluid (amrmpcomp) is live and two-way IB-coupled to the PD
#  solid (Usolid forcing + div(sigma) load). Same nondim & gas/shock IC as
#  amrcomp_impact, but the LIQUID drop is parked outside the domain (gas only) and
#  a copper PD disk takes the drop's place: it starts where the drop would (x=10),
#  co-moving with the pre-shock gas (U=1 toward the wall), and the impact radiates
#  shock waves into the gas. True reflecting wall BC stays at x=xlo=-Wall thickness.
# ============================================================================

# AMR grid
Base nx:   32
Base ny:   32
Base nz:   1
Max level: 5            # phase 1; original case uses 6 (bump for resolution)

# Regridding parameters
Regrid nsteps:      10
Tag Reynolds value: 100
Tag density error:  0.6
Tag pressure error: 0.3
Tag Ducros value:   0.5

# Geometry: true (reflecting) wall BC shifted to x=-Wall thickness; PD wall in [-Wall thickness,0]
Domain length:  20      # length unchanged; domain SHIFTED to [-Wall thickness, 20-Wall thickness] = [-1,19]
Drop location:  0.6     # liquid drop near the wall (front ~0.1 from x=0); launched at Impact velocity into at-rest gas
Shock location: 25      # parked outside the domain -> uniform at-rest (post-shock) gas; drop velocity imposed directly
Wall BC:        slip

# ---- PD solid bodies (clamped wall slab + incoming disk projectile) ----
# Copper wall, viscoplastic, nondim by (rhoG2, Delta-u, p_ref=rhoG2*Delta-u^2=14.8 MPa)
Material density:    1197.0    # rho_Cu/rho_ref = 8960/7.49
Elastic modulus:     7900.0    # E_Cu/p_ref = 117 GPa / 14.8 MPa
Poisson ratio:       0.34
Yield stretch:       0.0013    # sigma_Y/E ~ 150 MPa / 117 GPa -> yields then flows plastically
Relaxation time:     0.01      # viscoplastic flow rate (small -> near rate-independent)
Relaxation fraction: 1.0       # full deviatoric plastic flow above yield
Failure stretch:     0.3       # ductile: ~30% elongation before tearing
#Critical energy:    1.0e-3    # unused (ductile failure via Failure stretch)
Element size:       0.0125     # fine dx (L4)=0.0391 -> ~1.56x elem -> ~2.4 particles/fine cell (smooth VF)
Tagging VF:         0.1
# Wall: x in [0,Wall thickness], y in [-Wall half-height, +half]; back layer clamped
Wall thickness:     1.0
Wall half-height:   2.0
# Disk: center (Disk location,0), radius Disk radius, moving -x at Impact velocity
Disk radius:        0.5        # diameter 1 = drop diameter (the length scale)
Disk location:      3.0        # near the wall: front at 2.5 (just past shock at 2), wall front at 0
Impact velocity:    1.0        # U=1, co-moving with the pre-shock gas (u1=-1) -> no t=0 IB slip

# ---- Two-way IB coupling switches ----
Couple solid to fluid: .true.  # IB forcing of the gas by the moving solid
Couple fluid to solid: .true.  # div(sigma) load on the PD particles

# EOS parameters
GammaG: 1.3
GammaL: 1.43617
Liquid pinf:       55.2625
Liquid covolume:   0.003655
Liquid cv:         2.22961
Liquid qp:         7.1209
Gas Mach number:   1.95
Weber number:      3.69e5
Reynolds number:   3e5
Prandtl number:    0.71
Viscosity ratio:   21.05
Diffusivity ratio: 8.34
Sutherland exponent:    1.5
Sutherland temperature: 0.073

# Time integration
Max dt:   2e-3
Max CFL:  0.75
Max time: 15            # disk front (9.5) reaches wall (0) at t~9.5 at U=1, then aftermath

# Output
Output period:     5e-2
Checkpoint period: -1
Restart from:
