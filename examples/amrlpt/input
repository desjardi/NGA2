# Mesh parameters
Base nx:   16
Base ny:   16
Base nz:   1
Max level: 5

# Regridding parameters
Regrid nsteps:    10
Tagging vorticity: 0.5

# Flow parameter
Reynolds number: 1e4

# Particle parameters
Particle density:  2250
Particle diameter: 2e-2
Particle mfr:      1e-1

# Particle collisions
Restitution coeff: 0.5
Restitution wall:  0.1
Friction coeff:    0.5

# Time integration
Max time:    100
Max dt:      1e-3
Max CFL:     0.9

# Output
Output period: 0.5
