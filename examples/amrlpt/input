# Mesh parameters
Base nx:   16
Base ny:   16
Base nz:   16
Max level: 3

# Regridding parameters
Regrid nsteps:    10
Tagging vorticity: 0.5

# Flow parameter
Reynolds number: 100

# Particle parameters
Particle density:  1000
Particle diameter: 0.05
Particle mfr:      10

# Particle collisions
Restitution coeff: 0.5
Restitution wall:  0.5
Friction coeff:    0.5

# Fluid time integration
Max time: 100
Max dt:   1e-2
Max CFL:  0.9

# Particle time integration
Particle max dt:  2e-4
Particle max CFL: 0.9

# Output
Output period: 0.1
