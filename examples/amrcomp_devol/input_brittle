# DEMO CASE A -- BRITTLE FRACTURE (shatter), high Deborah number
# Identical to input_swell EXCEPT the material response: tau omitted => purely
# elastic-brittle (high De); Failure stretch omitted => G_c-derived brittle s0
# (~3%). Same loading/geometry/source. Expect fast, ~simultaneous fragmentation;
# nb_broken jumps near-vertically (vs the gradual climb in input_swell).

# AMR grid (2D: nz=1)
Base nx:   32
Base ny:   32
Base nz:   1
Max level: 4

# Regridding parameters
Regrid nsteps:     10
Tagging Re:        10
Tagging Rho:       0.1
Tagging VF:        0.1

# EoS
Gamma: 1.4

# Quiescent ambient gas (reference T0=1 sets Cv from p0,rho0)
Ambient pressure:  1.0
Ambient density:   1.0

# Isothermal degassing source (injected into open pores)
Source rate:         0.02    # per unit SURFACE AREA (rate = src_mdot*|grad VFf|); same as input_swell
Source temperature:  5.0     # hot gas (x ambient T0=1); e_inj = Cv*Tsrc
Source VF threshold: 0.5     # inject only where fluid fraction exceeds this

# Viscous parameters
Reynolds number:   1e4
Prandtl number:    0.71

# Solid pellet (peridynamics porous disk)
Material density:  10.0
Elastic modulus:   20.0
Poisson ratio:     0.25
Element size:      0.0125
Disk radius:       1.0
Number of pores:   55
Pore radius min:   0.03
Pore radius max:   0.08

# Coupling direction switches (absent -> fully coupled)
Couple solid to fluid: .true.
Couple fluid to solid: .true.
Critical energy:   1.0e-3      # brittle s0 (~3%) from G_c
# Failure stretch:  (omitted)  -> use brittle G_c s0
# Relaxation time:  (omitted)  -> tau=huge -> purely elastic-brittle (high De)
# Relaxation fraction: (omitted, irrelevant when tau=huge)

# Time integration
Use projection: .false.   # 2D must run explicit
Subiterations:  2
Max dt:   0.5e-2
Max CFL:  0.75
Max time: 8

# Output
Output period: 0.05
