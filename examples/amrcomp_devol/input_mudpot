# DEMO CASE C -- "MUDPOT": deep-ductile, low Deborah number, coherent roiling
# Identical to input_swell EXCEPT a more fluid matrix (tau 0.1->0.03) and a much
# larger failure stretch (0.3->1.0) so the bulk stays COHERENT: pores inflate into
# large bubbles, the matrix reflows around them, and only thin surface films burst
# (occasional venting) -- a churning swelling blob, not fragmentation. Failure
# stretch stays FINITE (1.0) so the search radius auto-sizes to 2.4*delta (covers
# 100% stretch); do NOT set it to huge (unbreakable -> silent bond drops).
# No gravity here, so bubbles vent radially outward rather than buoyantly rising;
# add Gravity for true rising-bubble behavior.

# AMR grid (2D: nz=1)
Base nx:   32
Base ny:   32
Base nz:   1
Max level: 4

# Regridding parameters
Regrid nsteps:     10
Tagging Re:        10
Tagging Rho:       0.1
Tagging VF:        0.1

# EoS
Gamma: 1.4

# Quiescent ambient gas (reference T0=1 sets Cv from p0,rho0)
Ambient pressure:  1.0
Ambient density:   1.0

# Isothermal degassing source (injected into open pores)
Source rate:         0.02    # per unit SURFACE AREA (rate = src_mdot*|grad VFf|); same as input_swell
Source temperature:  5.0     # hot gas (x ambient T0=1); e_inj = Cv*Tsrc
Source VF threshold: 0.5     # inject only where fluid fraction exceeds this

# Viscous parameters
Reynolds number:   1e4
Prandtl number:    0.71

# Solid pellet (peridynamics porous disk)
Material density:  10.0
Elastic modulus:   20.0
Poisson ratio:     0.25
Element size:      0.0125
Disk radius:       1.0
Number of pores:   55
Pore radius min:   0.03
Pore radius max:   0.08

# Coupling direction switches (absent -> fully coupled)
Couple solid to fluid: .true.
Couple fluid to solid: .true.
Critical energy:   1.0e-3      # (overridden by Failure stretch below)
Failure stretch:   0.6         # moderate: thin inter-bubble films (high local stretch) POP & vent, bulk keeps swelling
Relaxation time:   0.03        # Maxwell tau: low -> lots of flow/swell (swelling comes from tau, not failure stretch)
Relaxation fraction: 1.0       # SLS lambda: 1=pure Maxwell (full flow)

# Time integration
Use projection: .false.   # 2D must run explicit
Subiterations:  2
Max dt:   0.5e-2
Max CFL:  0.75
Max time: 12

# Output
Output period: 0.05
