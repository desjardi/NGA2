# AMR grid
Base nx:   32
Base ny:   32
Base nz:   8
Max level: 5

# Regridding parameters
Regrid nsteps:     10
Tagging Re:        10
Tagging Rho:       0.1

# EoS parameters
Gamma: 1.4

# Shock parameters
Mach number:     0.05
Shock location: -0.6

# Viscous parameters
Reynolds number:   1e4
Prandtl number:    0.71

# Time integration
Use projection: .true.
Max dt:   0.5e-2
Max CFL:  0.5
Max time: 50

# Output
Output period: 0.01